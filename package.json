{
  "name": "lms-monorepo",
  "version": "1.0.0",
  "description": "Bootcamp LMS Monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "test:server": "npm test --prefix server",
    "test:e2e": "npx playwright test --config=client/playwright.config.js",
    "clean:test-data": "node server/src/scripts/clean_test_data.js",
    "build:client": "npm run build --prefix client"
  }
}
